{
  "name": "vectide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "test:browser": "playwright test",
    "format:check": "prettier --check src tests e2e *.ts *.json index.html"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.1"
}
